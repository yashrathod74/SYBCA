SQL> CREATE TABLE def15_Salesman (
  2      Sid INT PRIMARY KEY,
  3      name VARCHAR(50),
  4      city VARCHAR(50),
  5      commission DECIMAL(4,2)
  6  );

Table created.

SQL> CREATE TABLE def15_Customer (
  2      C_id INT PRIMARY KEY,
  3      cname VARCHAR(50),
  4      city VARCHAR(50),
  5      grade INT,
  6      salesman_id INT,
  7      FOREIGN KEY (salesman_id) REFERENCES def15_Salesman(Sid)
  8  );

Table created.

