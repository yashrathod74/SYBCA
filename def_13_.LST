  4      order_date DATE,
  5      cust_id INT,
  6      salesman_id INT,
  7      FOREIGN KEY (cust_id) REFERENCES def13_Customer(cust_id),
  8      FOREIGN KEY (salesman_id) REFERENCES def13_Salesman(salesman_id)
  9  );

