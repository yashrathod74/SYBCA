SQL> CREATE TABLE def13_Customer (
  2      cust_id INT PRIMARY KEY,
  3      cname VARCHAR(50),
  4      city VARCHAR(50),
  5      grade INT,
  6      salesman_id INT,
  7      FOREIGN KEY (salesman_id) REFERENCES def13_Salesman(salesman_id)
  8  );

