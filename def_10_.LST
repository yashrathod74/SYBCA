CREATE TABLE def10_customer (
  2      cname VARCHAR(50) PRIMARY KEY,
  3      city VARCHAR(50) NOT NULL
  4  );

Table created.

SQL> 
SQL> CREATE TABLE def10_branch (
  2      bname VARCHAR(50) PRIMARY KEY,
  3      city VARCHAR(50) NOT NULL
  4  );

Table created.

SQL> 
SQL> CREATE TABLE def_10deposit (
  2      actno INT PRIMARY KEY,
  3      cname VARCHAR(50),
  4      bname VARCHAR(50),
  5      amount DECIMAL(10, 2),
  6      adate DATE,
  7      FOREIGN KEY (cname) REFERENCES def10_customer(cname),
  8      FOREIGN KEY (bname) REFERENCES def10_branch(bname)
  9  );

Table created.

SQL> 
SQL> CREATE TABLE def10_borrow (
  2      loanno INT PRIMARY KEY,
  3      cname VARCHAR(50),
  4      bname VARCHAR(50),
  5      amount DECIMAL(10, 2),
  6      FOREIGN KEY (cname) REFERENCES def10_customer(cname),
  7      FOREIGN KEY (bname) REFERENCES def10_branch(bname)
  8  );

Table created.

