SQL> SELECT DISTINCT c.cname
  2  FROM def10_customer c
  3  JOIN def_10deposit d ON c.cname = d.cname
  4  JOIN def10_borrow br ON c.cname = br.cname
  5  WHERE c.city = 'Nagpur';

CNAME                                                                           
--------------------------------------------------                              
Mehool                                                                          
Pramod                                                                          

SQL> 
SQL> SELECT DISTINCT br.cname
  2  FROM def10_borrow br
  3  JOIN def_10deposit d ON br.cname = d.cname
  4  WHERE d.amount > 1000 AND br.amount > 2000;

CNAME                                                                           
--------------------------------------------------                              
Anil                                                                            
Mehool                                                                          

SQL> SELECT
  2      br.loanno,
  3      br.amount AS loan_amount,
  4      d.actno,
  5      d.amount AS deposit_amount
  6  FROM def10_customer c
  7  JOIN def_10deposit d ON c.cname = d.cname
  8  JOIN def10_borrow br ON c.cname = br.cname
  9  WHERE c.city = 'Nagpur';

    LOANNO LOAN_AMOUNT      ACTNO DEPOSIT_AMOUNT                                
---------- ----------- ---------- --------------                                
       202        3500        103           3000                                
       204        2200        104            800                                

SQL> SELECT DISTINCT
  2      c.city AS living_city,
  3      b.city AS branch_city
  4  FROM def10_customer c
  5  LEFT JOIN def_10deposit d ON c.cname = d.cname
  6  LEFT JOIN def10_borrow br ON c.cname = br.cname
  7  LEFT JOIN def10_branch b ON (d.bname = b.bname OR br.bname = b.bname)
  8  WHERE c.cname = 'Anil';

LIVING_CITY                                                                     
--------------------------------------------------                              
BRANCH_CITY                                                                     
--------------------------------------------------                              
Mumbai                                                                          
Nagpur                                                                          
                                                                                

