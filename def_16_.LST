SQL> SELECT name AS entity_name, city, 'Salesman' AS entity_type
  2  FROM def16_Salesman
  3  WHERE city = 'London'
  4  UNION
  5  SELECT cname AS entity_name, city, 'Customer' AS entity_type
  6  FROM def16_Customer
  7  WHERE city = 'London';

