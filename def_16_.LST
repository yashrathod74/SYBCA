CREATE TABLE def16_Salesman (
  2      Sid INT PRIMARY KEY,
  3      name VARCHAR(100) NOT NULL,
  4      city VARCHAR(100) NOT NULL,
  5      commission DECIMAL(5, 2) NOT NULL
  6  );

Table created.

SQL> CREATE TABLE def16_Customer (
  2      C_id INT PRIMARY KEY,
  3      cname VARCHAR(100) NOT NULL,
  4      city VARCHAR(100) NOT NULL,
  5      grade INT,
  6      salesman_id INT,
  7      FOREIGN KEY (salesman_id) REFERENCES def16_Salesman(Sid)
  8  );

Table created.

