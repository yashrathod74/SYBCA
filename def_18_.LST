SQL> SELECT
  2      c.com_name,
  3      AVG(i.price) AS average_price
  4  FROM def18_Company_master c
  5  JOIN def18_Item_Master i
  6    ON c.Com_id = i.company_code
  7  GROUP BY c.Com_id, c.com_name;

COM_NAME                                                                        
--------------------------------------------------------------------------------
AVERAGE_PRICE                                                                   
-------------                                                                   
