SELECT
  2      i.Item_id,
  3      i.Item_name,
  4      i.price,
  5      i.company_code,
  6      c.com_name AS producer_company
  7  FROM def18_Item_Master i
  8  JOIN def18_Company_master c
  9    ON i.company_code = c.Com_id;

